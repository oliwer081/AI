/**
 * cube3d.js — Lightweight 3D Rubik's Cube renderer using Canvas 2D
 * Isometric projection, drag-to-rotate, configurable size.
 */

class RubiksCube3D {
  constructor(canvas, options = {}) {
    this.canvas = canvas;
    this.ctx = canvas.getContext('2d');
    this.size = options.size || 3; // 2 or 3
    this.cellSize = options.cellSize || 38;
    this.gap = options.gap || 3;
    this.rotX = options.rotX ?? -0.5;
    this.rotY = options.rotY ?? 0.7;

    // Colors: U=white, D=yellow, F=red, B=orange, R=blue, L=green
    this.COLORS = {
      U: '#f8f9fa', D: '#e9c46a', F: '#e63946',
      B: '#f4a261', R: '#457b9d', L: '#2a9d8f', X: '#1a1a1e'
    };

    // Initialize face arrays
    this.faces = {
      U: Array(this.size * this.size).fill('U'),
      D: Array(this.size * this.size).fill('D'),
      F: Array(this.size * this.size).fill('F'),
      B: Array(this.size * this.size).fill('B'),
      R: Array(this.size * this.size).fill('R'),
      L: Array(this.size * this.size).fill('L'),
    };

    this._drag = false;
    this._lastX = 0;
    this._lastY = 0;
    this._raf = null;
    this._bindEvents();
    this.render();
  }

  setFace(face, colors) {
    this.faces[face] = colors;
    this.render();
  }

  setAllFaces(faceMap) {
    Object.assign(this.faces, faceMap);
    this.render();
  }

  _bindEvents() {
    const el = this.canvas;
    el.addEventListener('mousedown', e => { this._drag = true; this._lastX = e.clientX; this._lastY = e.clientY; });
    el.addEventListener('touchstart', e => { this._drag = true; this._lastX = e.touches[0].clientX; this._lastY = e.touches[0].clientY; }, {passive:true});
    window.addEventListener('mouseup', () => { this._drag = false; });
    window.addEventListener('touchend', () => { this._drag = false; });
    window.addEventListener('mousemove', e => {
      if (!this._drag) return;
      const dx = e.clientX - this._lastX;
      const dy = e.clientY - this._lastY;
      this.rotY += dx * 0.012;
      this.rotX += dy * 0.012;
      this.rotX = Math.max(-Math.PI/2 + 0.1, Math.min(Math.PI/2 - 0.1, this.rotX));
      this._lastX = e.clientX; this._lastY = e.clientY;
      this.render();
    });
    window.addEventListener('touchmove', e => {
      if (!this._drag) return;
      const dx = e.touches[0].clientX - this._lastX;
      const dy = e.touches[0].clientY - this._lastY;
      this.rotY += dx * 0.012;
      this.rotX += dy * 0.012;
      this.rotX = Math.max(-Math.PI/2 + 0.1, Math.min(Math.PI/2 - 0.1, this.rotX));
      this._lastX = e.touches[0].clientX; this._lastY = e.touches[0].clientY;
      this.render();
    }, {passive: true});
  }

  // Project 3D point to 2D canvas
  _project(x, y, z) {
    const cosX = Math.cos(this.rotX), sinX = Math.sin(this.rotX);
    const cosY = Math.cos(this.rotY), sinY = Math.sin(this.rotY);
    // Rotate Y then X
    const x1 = cosY * x + sinY * z;
    const z1 = -sinY * x + cosY * z;
    const y1 = sinX * z1 + cosX * y;
    const z2 = cosX * z1 - sinX * y;

    const fov = 380;
    const depth = fov + z2;
    return {
      sx: (this.canvas.width / 2) + (x1 * fov) / depth,
      sy: (this.canvas.height / 2) + (y1 * fov) / depth,
      z: z2
    };
  }

  _drawQuad(pts, color, borderColor) {
    const ctx = this.ctx;
    ctx.beginPath();
    ctx.moveTo(pts[0].sx, pts[0].sy);
    for (let i = 1; i < pts.length; i++) ctx.lineTo(pts[i].sx, pts[i].sy);
    ctx.closePath();
    ctx.fillStyle = color;
    ctx.fill();
    ctx.strokeStyle = borderColor || '#0d0d0f';
    ctx.lineWidth = 1.5;
    ctx.stroke();
  }

  _faceNormal(face) {
    switch(face) {
      case 'U': return [0, -1, 0];
      case 'D': return [0, 1, 0];
      case 'F': return [0, 0, 1];
      case 'B': return [0, 0, -1];
      case 'R': return [1, 0, 0];
      case 'L': return [-1, 0, 0];
    }
  }

  _isFaceVisible(face) {
    const n = this._faceNormal(face);
    // Dot product of normal with view direction
    const cosX = Math.cos(this.rotX), sinX = Math.sin(this.rotX);
    const cosY = Math.cos(this.rotY), sinY = Math.sin(this.rotY);
    // Camera direction in local space (inverse rotation applied to [0,0,-1])
    const cx = sinY;
    const cy = -sinX * cosY;
    const cz = cosX * cosY;
    return n[0]*cx + n[1]*cy + n[2]*cz > 0.01;
  }

  render() {
    const { canvas, ctx, size } = this;
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    const s = this.size;
    const cs = this.cellSize;
    const gap = this.gap;
    const total = s * (cs + gap) - gap;
    const half = total / 2;

    const polys = [];

    const addFace = (face, cx, cy, cz, ax, ay, az, bx, by, bz, u, v) => {
      const c = this.faces[face][v * s + u];
      const color = this.COLORS[c] || this.COLORS.X;

      const pts = [
        this._project(cx, cy, cz),
        this._project(cx + ax * cs, cy + ay * cs, cz + az * cs),
        this._project(cx + ax * cs + bx * cs, cy + ay * cs + by * cs, cz + az * cs + bz * cs),
        this._project(cx + bx * cs, cy + by * cs, cz + bz * cs),
      ];
      const avgZ = pts.reduce((s, p) => s + p.z, 0) / 4;
      polys.push({ pts, color, avgZ });
    };

    // For each cubie face...
    for (let i = 0; i < s; i++) {
      for (let j = 0; j < s; j++) {
        const u = j, v = i;
        const sx = (cs + gap);

        if (this._isFaceVisible('F')) {
          const x = -half + j * sx;
          const y = -half + i * sx;
          addFace('F', x, y, half + 1, 1,0,0, 0,1,0, u, v);
        }
        if (this._isFaceVisible('B')) {
          const x = half - j * sx;
          const y = -half + i * sx;
          addFace('B', x, y, -half - 1, -1,0,0, 0,1,0, u, v);
        }
        if (this._isFaceVisible('R')) {
          const y = -half + i * sx;
          const z = -half + j * sx;
          addFace('R', half + 1, y, half - j * sx, 0,0,-1, 0,1,0, u, v);
        }
        if (this._isFaceVisible('L')) {
          const y = -half + i * sx;
          addFace('L', -half - 1, y, -half + j * sx, 0,0,1, 0,1,0, u, v);
        }
        if (this._isFaceVisible('U')) {
          const x = -half + j * sx;
          const z = -half + i * sx;
          addFace('U', x, -half - 1, half - i * sx, 1,0,0, 0,0,-1, u, v);
        }
        if (this._isFaceVisible('D')) {
          const x = -half + j * sx;
          addFace('D', x, half + 1, -half + i * sx, 1,0,0, 0,0,1, u, v);
        }
      }
    }

    // Painter's algorithm
    polys.sort((a, b) => a.avgZ - b.avgZ);
    for (const p of polys) {
      this._drawQuad(p.pts, p.color, '#0d0d0f');
    }
  }

  destroy() {
    cancelAnimationFrame(this._raf);
  }
}

// Auto-animate the hero cube
document.addEventListener('DOMContentLoaded', () => {
  const heroCanvas = document.getElementById('heroCube');
  if (!heroCanvas) return;
  const cube = new RubiksCube3D(heroCanvas, { size: 3, cellSize: 42, rotX: -0.42, rotY: 0.75 });
  let angle = 0.75;
  const animate = () => {
    if (!cube._drag) {
      angle += 0.004;
      cube.rotY = angle;
      cube.render();
    }
    requestAnimationFrame(animate);
  };
  animate();
});
// main.js — UI logic, tabs, nav toggle

document.addEventListener('DOMContentLoaded', () => {
  // Mobile nav toggle
  const toggle = document.querySelector('.nav-toggle');
  const links = document.querySelector('.nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', () => links.classList.toggle('open'));
    document.addEventListener('click', e => {
      if (!toggle.contains(e.target) && !links.contains(e.target)) {
        links.classList.remove('open');
      }
    });
  }

  // Tabs
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.group;
      const target = btn.dataset.tab;
      document.querySelectorAll(`.tab-btn[data-group="${group}"]`).forEach(b => b.classList.remove('active'));
      document.querySelectorAll(`.tab-panel[data-group="${group}"]`).forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector(`.tab-panel[data-group="${group}"][data-tab="${target}"]`)?.classList.add('active');
    });
  });

  // Active nav link highlight
  const path = window.location.pathname;
  document.querySelectorAll('.nav-links a').forEach(a => {
    if (a.getAttribute('href') && path.endsWith(a.getAttribute('href').replace('../', '').replace('./', ''))) {
      a.classList.add('active');
    }
  });

  // Smooth section anchors from homepage
  document.querySelectorAll('a[href*="#"]').forEach(anchor => {
    anchor.addEventListener('click', function(e) {
      const href = this.getAttribute('href');
      if (href.includes('#') && !href.startsWith('#')) return; // let browser handle cross-page
      const id = href.split('#')[1];
      const el = document.getElementById(id);
      if (el) {
        e.preventDefault();
        el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Sidebar active state on scroll
  const sidebarLinks = document.querySelectorAll('.sidebar-nav a');
  if (sidebarLinks.length) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          sidebarLinks.forEach(l => l.classList.remove('active'));
          const match = document.querySelector(`.sidebar-nav a[href="#${id}"]`);
          if (match) match.classList.add('active');
        }
      });
    }, { rootMargin: '-20% 0px -70% 0px' });

    document.querySelectorAll('.step-section[id]').forEach(s => observer.observe(s));
  }
});

// Helper: render move sequence as styled spans
function renderMoves(algoStr) {
  return algoStr.trim().split(/\s+/).map(m => {
    let cls = 'move';
    if (m.includes("'")) cls += ' prime';
    else if (m.includes('2')) cls += ' double';
    return `<span class="${cls}">${m}</span>`;
  }).join('');
}

// Call on page load for all .algo-moves elements
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('[data-algo]').forEach(el => {
    el.innerHTML = renderMoves(el.dataset.algo);
  });
});
# 🧩 KUBGUIDE — Rubik's Cube Lösningsguide

En interaktiv webbplats för att lära sig lösa Rubik's Cube — både 2×2 och 3×3. Byggd med ren HTML, CSS och JavaScript utan beroenden.

## ✨ Funktioner

- **Interaktiv 3D-kub** — Roterbar 3D-visualisering på varje sida (dra med musen/pekskärm)
- **3×3 Nybörjarmetoden** — 7 steg, lager-för-lager med alla algoritmer
- **3×3 CFOP/Fridrich** — Cross, F2L, OLL (vanligaste fallen), PLL (12 fall)
- **2×2 Nybörjarmetoden** — 4 steg med Sune-algoritmen
- **2×2 OLL** — Alla 7 orienteringsfall med diagram
- **2×2 PBL** — Alla 5 permutationsfall (Permutation of Both Layers)
- **Notationsreferens** — Komplett guide till Singmaster-notation
- **Mobilanpassad** — Fungerar på alla skärmstorlekar
- **Mörkt tema** — Stylad med ett distinkt mörkt, minimalistiskt utseende

## 📁 Struktur

```
rubiks-cube-solver/
├── index.html              # Startsida
├── css/
│   └── style.css           # All styling
├── js/
│   ├── cube3d.js           # 3D canvas-renderer
│   └── main.js             # UI-logik, tabs, nav
└── pages/
    ├── 3x3.html            # 3×3 guide (nybörjare + CFOP)
    ├── 2x2.html            # 2×2 guide (nybörjare + OLL + PBL)
    └── notation.html       # Notationsreferens
```

## 🚀 Kom igång

### Lokalt
