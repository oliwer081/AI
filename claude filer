<script>
  document.addEventListener('DOMContentLoaded', () => {
    const c = document.getElementById('cube2x2');
    if (c) {
      const cube = new RubiksCube3D(c, { size: 2, cellSize: 58, rotX: -0.42, rotY: 0.8 });
      let a = 0.8;
      const animate = () => {
        if (!cube._drag) { a += 0.005; cube.rotY = a; cube.render(); }
        requestAnimationFrame(animate);
      };
      animate();
    }
    document.querySelectorAll('.case-algo[data-algo]').forEach(el => {
      el.textContent = el.dataset.algo;
    });
  });
